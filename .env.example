# Copy to .env.local for development, and set the same values in your host's
# environment-variable settings (Cloudflare Pages / Netlify / Vercel) for production.
# These are all PUBLIC values that end up in the browser — never put secret keys here.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://bkcaozczhiyxlkghtidl.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Your live domain, no trailing slash. Used for share previews, canonical URL and sitemap.
VITE_SITE_URL=https://www.example-church.in
VITE_SITE_NAME=Vine India
VITE_SITE_DESCRIPTION=A place to grow in faith, family and fellowship. Join us on Sunday, in a cell group, or online.

# Optional: Cloudflare Turnstile spam protection for the contact form (site key is public).
# Also set TURNSTILE_SECRET_KEY as a Supabase Edge Function secret.
VITE_TURNSTILE_SITE_KEY=
